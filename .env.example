# Root domain without protocol. Local dev: localhost:3000 (subdomains: kushal.localhost:3000)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# http for local dev, https in production
NEXT_PUBLIC_PROTOCOL=http
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never expose to the browser. Used by /api/leads only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Set to ".yourdomain.com" in production to share the session across subdomains. Leave empty locally.
SESSION_COOKIE_DOMAIN=
